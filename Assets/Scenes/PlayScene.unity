--- !u!114 &1606039546
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1606039544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "+ Di chuy\u1EC3n: Ng\u01B0\u1EDDi ch\u01A1i s\u1EED d\u1EE5ng n\xFAt \u0111i\u1EC1u
    h\u01B0\u1EDBng tr\xEAn b\xE0n ph\xEDm ho\u1EB7c c\xE1c n\xFAt A, W, S, D \u0111\u1EC3
    di chuy\u1EC3n.\n+ M\u1EDF kho \u0111\u1ED3: Ng\u01B0\u1EDDi ch\u01A1i \u1EA5n
    n\xFAt B tr\xEAn b\xE0n ph\xEDm \u0111\u1EC3 m\u1EDF kho \u0111\u1ED3 .\n+ Cu\u1ED1c
    \u0111\u1EA5t: Ng\u01B0\u1EDDi ch\u01A1i \u0111\u1EBFn g\u1EA7n \xF4 \u0111\u1EA5t
    c\u1EA7n cu\u1ED1c trong v\u01B0\u1EDDn v\xE0 d\xF9ng con tr\u1ECF chu\u1ED9t
    tr\u1ECF v\xE0o \xF4 \u0111\u1EA5t c\u1EA7n cu\u1ED1c sau \u0111\xF3 \u1EA5n
    ph\xEDm C \u0111\u1EC3 th\u1EF1c hi\u1EC7n h\xE0nh \u0111\u1ED9ng cu\u1ED1c \u0111\u1EA5t.\n+
    Tr\u1ED3ng c\xE2y: Ng\u01B0\u1EDDi ch\u01A1i \u0111\u1EBFn g\u1EA7n \xF4 \u0111\u1EA5t
    v\xE0 d\xF9ng con tr\u1ECF chu\u1ED9t tr\u1ECF v\xE0o \xF4 \u0111\u1EA5t \u0111\xE3
    cu\u1ED1c r\u1ED3i \u1EA5n chu\u1ED9t ph\u1EA3i \u0111\u1EC3 tr\u1ED3ng c\xE2y
    ( l\u01B0u \xFD l\xE0 ph\u1EA3i l\u1EA5y h\u1EA1t gi\u1ED1ng ra 1 trong 2 \xF4
    \u0111\u1EC3 \u0111\u1ED3 r\u1ED3i ch\u1ECDn \xF4 \u0111\u1EC3 \u0111\u1ED3 ch\u1EE9a
    h\u1EA1t gi\u1ED1ng c\u1EA7n tr\u1ED3ng).\n+ T\u01B0\u1EDBi c\xE2y: Ng\u01B0\u1EDDi
    ch\u01A1i \u0111\u1EBFn g\u1EA7n \xF4 \u0111\u1EA5t \u0111\xE3 tr\u1ED3ng c\xE2y
    v\xE0 d\xF9ng con tr\u1ECF chu\u1ED9t tr\u1ECF v\xE0o \xF4 \u0111\u1EA5t r\u1ED3i
    \u1EA5n ph\xEDm E \u0111\u1EC3 th\u1EF1c hi\u1EC7n h\xE0nh \u0111\u1ED9ng t\u01B0\u1EDBi
    c\xE2y.\n+ Thu ho\u1EA1ch: Ng\u01B0\u1EDDi ch\u01A1i d\xF9ng con tr\u1ECF chu\u1ED9t
    tr\u1ECF v\xE0o \xF4 \u0111\u1EA5t ch\u1EE9a c\xE2y \u0111\xE3 ph\xE1t tri\u1EC3n
    ho\xE0n to\xE0n r\u1ED3i \u1EA5n ph\xEDm M \u0111\u1EC3 ti\u1EBFn h\xE0nh thu
    ho\u1EA1ch v\u1EADt ph\u1EA9m v\xE0o kho \u0111\u1ED3.\n+ Xay b\u1ED9t: Ng\u01B0\u1EDDi
    ch\u01A1i \u0111\u1EBFn g\u1EA7n l\u1ED1i xay gi\xF3 s\u1EBD hi\u1EC3n th\u1ECB
    n\xFAt Xay b\u1ED9t, ng\u01B0\u1EDDi ch\u01A1i c\u1EA7n c\xF3 \xEDt nh\u1EA5t
    x2 l\xFAa \u0111\u1EC3 th\u1EF1c hi\u1EC7n xay b\u1ED9t. Sau kho\u1EA3ng th\u1EDDi
    gian nh\u1EA5t \u0111\u1ECBnh, n\xFAt Thu th\u1EADp s\u1EBD hi\u1EC3n th\u1ECB
    v\xE0 ng\u01B0\u1EDDi ch\u01A1i \u1EA5n n\xFAt \u0111\u1EC3 c\xF3 th\u1EC3 nh\u1EADn
    b\u1ED9t v\u1EC1 kho \u0111\u1ED3.\n+ C\xE2u c\xE1: Ng\u01B0\u1EDDi ch\u01A1i
    \u0111\u1EBFn h\u1ED3 v\xE0 \u0111\u1EE9ng l\xEAn c\xE2y c\u1EA7u nh\u1ECF s\u1EBD
    hi\u1EC3n th\u1ECB n\xFAt C\xE2u c\xE1, ng\u01B0\u1EDDi ch\u01A1i c\u1EA7n c\xF3
    \xEDt nh\u1EA5t x1 m\u1ED3i c\xE2u \u0111\u1EC3 th\u1EF1c hi\u1EC7n c\xE2u c\xE1.
    Sau kho\u1EA3ng th\u1EDDi gian nh\u1EA5t \u0111\u1ECBnh, n\xFAt Thu c\u1EA7n
    s\u1EBD hi\u1EC3n th\u1ECB v\xE0 ng\u01B0\u1EDDi ch\u01A1i \u1EA5n n\xFAt \u0111\u1EC3
    th\u1EF1c hi\u1EC7n thu c\u1EA7n c\xE2u v\xE0 thu th\u1EADp c\xE1 v\xE0o kho
    \u0111\u1ED3.\n+ Cho v\u1EADt nu\xF4i \u0103n: Ng\u01B0\u1EDDi ch\u01A1i \u0111\u1EBFn
    g\u1EA7n chu\u1ED3ng tr\u1EA1i c\u1EE7a v\u1EADt nu\xF4i s\u1EBD hi\u1EC7n n\xFAt
    Cho \u0103n.\n   - Chu\u1ED3ng l\u1EE3n: Ng\u01B0\u1EDDi ch\u01A1i c\u1EA7n \xEDt
    nh\u1EA5t x2 b\u1EAFp ng\xF4 \u0111\u1EC3 cho \u0103n. Sau kho\u1EA3ng th\u1EDDi
    gian nh\u1EA5t \u0111\u1ECBnh, n\xFAt Thu th\u1EADp s\u1EBD hi\u1EC3n th\u1ECB
    v\xE0 ng\u01B0\u1EDDi ch\u01A1i \u1EA5n n\xFAt \u0111\u1EC3 thu th\u1EADp Th\u1ECBt
    l\u1EE3n v\xE0o kho \u0111\u1ED3.\n   - Chu\u1ED3ng b\xF2: Ng\u01B0\u1EDDi ch\u01A1i
    c\u1EA7n \xEDt nh\u1EA5t x4 l\xFAa \u0111\u1EC3 cho \u0103n. Sau kho\u1EA3ng
    th\u1EDDi gian nh\u1EA5t \u0111\u1ECBnh, n\xFAt Thu th\u1EADp s\u1EBD hi\u1EC3n
    th\u1ECB v\xE0 ng\u01B0\u1EDDi ch\u01A1i \u1EA5n n\xFAt \u0111\u1EC3 thu th\u1EADp
    S\u1EEFa v\xE0o kho \u0111\u1ED3.\n   - Chu\u1ED3ng g\xE0: Ng\u01B0\u1EDDi ch\u01A1i
    c\u1EA7n \xEDt nh\u1EA5t x1 l\xFAa \u0111\u1EC3 cho \u0103n. Sau kho\u1EA3ng
    th\u1EDDi gian nh\u1EA5t \u0111\u1ECBnh, n\xFAt Thu th\u1EADp s\u1EBD hi\u1EC3n
    th\u1ECB v\xE0 ng\u01B0\u1EDDi ch\u01A1i \u1EA5n n\xFAt \u0111\u1EC3 thu th\u1EADp
    Tr\u1EE9ng v\xE0o kho \u0111\u1ED3.\n"
